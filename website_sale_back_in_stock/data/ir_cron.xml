<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The sweep is a background job on purpose: the mail must not be
             sent from the stock move or the receipt validation, where a
             transaction that is still rolling back could mail a customer
             about stock that never arrived. -->
        <record id="ir_cron_restock_sweep" model="ir.cron">
            <field name="name">Back in Stock: send the restock emails</field>
            <field name="model_id" ref="model_website_stock_notification"/>
            <field name="state">code</field>
            <field name="code">model._cron_sweep()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
