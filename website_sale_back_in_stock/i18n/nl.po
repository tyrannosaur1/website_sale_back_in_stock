#. module: website_sale_back_in_stock
#: model_terms:ir.ui.view,arch_db:website_sale_back_in_stock.notification_page
msgid ""
".\n"
"                            You can subscribe again from the product page."
msgstr ""
".\n"
"                            U kunt zich opnieuw aanmelden via de productpagina."

#. module: website_sale_back_in_stock
#: model:mail.template,body_html:website_sale_back_in_stock.mail_template_back_in_stock
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;\">\n"
"                    <p>Hello,</p>\n"
"                    <p>\n"
"                        <strong t-out=\"object.product_id.display_name\"/> is available again.\n"
"                    </p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object._stock_notify_product_url()\" style=\"display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:4px;\">\n"
"                            See the product\n"
"                        </a>\n"
"                    </p>\n"
"                    <p style=\"color:#666;font-size:12px;\">\n"
"                        You are receiving this message because you asked to be told\n"
"                        when this product came back.\n"
"                        <a t-att-href=\"object._stock_notify_unsubscribe_url()\">Unsubscribe</a>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;\">\n"
"                    <p>Hallo,</p>\n"
"                    <p>\n"
"                        <strong t-out=\"object.product_id.display_name\"/> is weer beschikbaar.\n"
"                    </p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object._stock_notify_product_url()\" style=\"display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:4px;\">\n"
"                            Bekijk het product\n"
"                        </a>\n"
"                    </p>\n"
"                    <p style=\"color:#666;font-size:12px;\">\n"
"                        U ontvangt dit bericht omdat u hebt gevraagd om een bericht\n"
"                        wanneer dit product weer op voorraad is.\n"
"                        <a t-att-href=\"object._stock_notify_unsubscribe_url()\">Afmelden</a>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: website_sale_back_in_stock
#: model:mail.template,body_html:website_sale_back_in_stock.mail_template_confirm
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;\">\n"
"                    <p>Hello,</p>\n"
"                    <p>\n"
"                        You asked us to tell you when\n"
"                        <strong t-out=\"object.product_id.display_name\"/> is available again.\n"
"                    </p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object._stock_notify_confirm_url()\" style=\"display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:4px;\">\n"
"                            Confirm my alert\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>If the button does not work, copy this address into your browser:</p>\n"
"                    <p><a t-att-href=\"object._stock_notify_confirm_url()\" t-out=\"object._stock_notify_confirm_url()\"/></p>\n"
"                    <p style=\"color:#666;font-size:12px;\">\n"
"                        If you did not ask for this, ignore this message; nothing is\n"
"                        sent unless the link above is opened.\n"
"                        <a t-att-href=\"object._stock_notify_unsubscribe_url()\">Unsubscribe</a>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;\">\n"
"                    <p>Hallo,</p>\n"
"                    <p>\n"
"                        U hebt ons gevraagd u te laten weten wanneer\n"
"                        <strong t-out=\"object.product_id.display_name\"/> weer beschikbaar is.\n"
"                    </p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object._stock_notify_confirm_url()\" style=\"display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:4px;\">\n"
"                            Mijn melding bevestigen\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Als de knop niet werkt, kopieert u dit adres naar uw browser:</p>\n"
"                    <p><a t-att-href=\"object._stock_notify_confirm_url()\" t-out=\"object._stock_notify_confirm_url()\"/></p>\n"
"                    <p style=\"color:#666;font-size:12px;\">\n"
"                        Als u hier niet om hebt gevraagd, negeer dit bericht; er wordt niets\n"
"                        verzonden tenzij de bovenstaande link wordt geopend.\n"
"                        <a t-att-href=\"object._stock_notify_unsubscribe_url()\">Afmelden</a>\n"
"                    </p>\n"
"                </div>\n"
"            "

