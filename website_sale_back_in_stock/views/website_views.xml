<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 17.0 replaced the div layout of the settings page with <setting>. -->
    <record id="res_config_settings_view_form_stock_notify" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.stock.notify</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='website_cookies_bar_setting']" position="after">
                <setting id="stock_notify_setting" string="Back-in-Stock Waitlist"
                         help="Let visitors ask to be told when an out-of-stock product is available again">
                    <div class="content-group">
                        <div class="row mt8">
                            <label class="col-lg-3" string="Waitlist" for="stock_notify_enabled"/>
                            <field name="stock_notify_enabled"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-3" string="Confirm by Email" for="stock_notify_double_optin"/>
                            <field name="stock_notify_double_optin"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-3" string="Restock Email" for="stock_notify_template_id"/>
                            <field name="stock_notify_template_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
